{
  "name": "@pal-bot/pi-coder",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pal-bot/pi-coder.git"
  },
  "homepage": "https://github.com/pal-bot/pi-coder#readme",
  "bugs": {
    "url": "https://github.com/pal-bot/pi-coder/issues"
  },
  "description": "Cost-aware model routing and private local usage records for Pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-routing",
    "usage-analytics"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "scripts/install.sh"
  ],
  "bin": {
    "pic": "bin/pic"
  },
  "exports": {
    ".": "./dist/extension.js"
  },
  "pi": {
    "extensions": [
      "./node_modules/@gotgenes/pi-anthropic-auth/src/index.ts",
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bun build src/extension.ts --target=node --format=esm --external @earendil-works/pi-coding-agent --external @earendil-works/pi-ai --outdir dist",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@gotgenes/pi-anthropic-auth": "3.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.7.2",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
